# MySQL
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=ai_finance
MYSQL_USER=ai_finance
MYSQL_PASSWORD=ai_finance_password
MYSQL_PORT=3307

# App ports
BACKEND_PORT=8080
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DeepSeek AI（不要把真实密钥提交到 Git；只写在本地 .env）
# Docker：修改 .env 后必须重建后端容器，密钥才会进容器，例如：
#   docker compose --profile dev up -d --force-recreate backend-dev
# 然后重新 exec 运行 mvn spring-boot:run。仅 docker restart 不会刷新环境变量。
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 官方文档模型：deepseek-v4-pro、deepseek-v4-flash；若报错可改为 deepseek-chat（兼容）
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high
# 若请求异常可先改为 false 再试
DEEPSEEK_THINKING_ENABLED=true
