# MySQL
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=ai_finance
MYSQL_USER=ai_finance
MYSQL_PASSWORD=ai_finance_password
MYSQL_PORT=3307

# Redis
REDIS_PORT=6379

# App ports
BACKEND_PORT=8080
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DeepSeek AI（不要把真實金鑰提交到 Git；只寫在本地 .env）
# Docker：修改 .env 後必須重建後端容器，金鑰才會進容器，例如：
#   docker compose --profile dev up -d --force-recreate backend-dev
# 然後重新 exec 運行 mvn spring-boot:run。僅 docker restart 不會刷新環境變數。
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek 官方有效模型名稱為 deepseek-reasoner (R1推理模型) 或 deepseek-chat (V3通用模型)
DEEPSEEK_MODEL=deepseek-reasoner
DEEPSEEK_REASONING_EFFORT=high
# 若請求異常可先改為 false 再試
DEEPSEEK_THINKING_ENABLED=true
